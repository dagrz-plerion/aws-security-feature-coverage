{
  "_comment": "How to read a page whose shape the generic reader cannot handle. Each rule applies to every page whose URL matches urlPattern. See docs/specs/coverage-extraction.md for the fields. A recipe that stops producing what it promises is reported, never silently dropped.",
  "rules": [
    {
      "urlPattern": "IAM/latest/UserGuide/access-analyzer-resources\\.md$",
      "serviceId": "access-analyzer",
      "note": "One page, three analyzer types, three different resource lists. Each H2 names the analyzer type, so each is pinned to its own feature.",
      "recipes": [
        {
          "id": "access-analyzer-external-resources",
          "blocks": "h2-sections",
          "select": {
            "from": "list-items",
            "extract": "whole",
            "matches": "^(Amazon|AWS) ",
            "split": "\\s+and\\s+(?=layers$)"
          },
          "axis": "resourceType",
          "status": "covered",
          "featureId": "access-analyzer/external-access-analyzer",
          "requireMin": 10,
          "onlyBlocksMatching": "external access"
        },
        {
          "id": "access-analyzer-internal-resources",
          "blocks": "h2-sections",
          "select": {
            "from": "list-items",
            "extract": "whole",
            "matches": "^(Amazon|AWS) ",
            "split": "\\s+and\\s+(?=layers$)"
          },
          "axis": "resourceType",
          "status": "covered",
          "featureId": "access-analyzer/internal-access-analyzer",
          "requireMin": 4,
          "onlyBlocksMatching": "internal access"
        }
      ]
    },
    {
      "urlPattern": "securityhub/latest/userguide/regions-controls\\.md$",
      "serviceId": "securityhub",
      "note": "One H2 per Region, each listing the controls that are NOT available there. The control id is the bracketed prefix of each bullet.",
      "recipes": [
        {
          "id": "securityhub-regional-control-limits",
          "blocks": "h2-sections",
          "select": {
            "from": "list-items",
            "extract": "leading-bracket",
            "matches": "^[A-Z][A-Za-z0-9]{1,20}\\.\\d{1,3}$"
          },
          "axis": "control",
          "status": "not-covered",
          "scope": {
            "axis": "region",
            "from": "block-title"
          },
          "featureId": "securityhub/security-hub-cspm",
          "requireMin": 20
        }
      ]
    },
    {
      "urlPattern": "config/latest/developerguide/managed-rules-by-aws-config\\.md$",
      "serviceId": "config",
      "note": "The full catalogue of AWS Config managed rules, one bullet each.",
      "recipes": [
        {
          "id": "config-managed-rule-catalogue",
          "blocks": "whole-page",
          "select": {
            "from": "list-items",
            "extract": "whole",
            "matches": "^[a-z][a-z0-9]*(-[a-z0-9]+){2,}$"
          },
          "axis": "configRule",
          "status": "covered",
          "requireMin": 100
        }
      ]
    },
    {
      "urlPattern": "guardduty/latest/ug/guardduty_finding-types-[a-z0-9-]+\\.md$",
      "serviceId": "guardduty",
      "note": "Each H2 is one GuardDuty finding type. Boilerplate headings such as See also are excluded by shape.",
      "recipes": [
        {
          "id": "guardduty-finding-type-headings",
          "blocks": "whole-page",
          "select": {
            "from": "headings",
            "level": 2,
            "extract": "whole",
            "matches": "^[A-Z][A-Za-z]*:[A-Za-z0-9]+/[A-Za-z0-9._!&-]+$"
          },
          "axis": "findingType",
          "status": "covered",
          "requireMin": 3
        }
      ]
    },
    {
      "urlPattern": "macie/latest/user/mdis-reference-quick\\.md$",
      "serviceId": "macie2",
      "note": "The managed data identifier catalogue, in the identifier ID column.",
      "recipes": [
        {
          "id": "macie-managed-data-identifiers",
          "blocks": "whole-page",
          "select": {
            "from": "table-column",
            "headerMatches": "identifier",
            "extract": "whole",
            "matches": "^[A-Z][A-Z0-9]*(_[A-Z0-9]+)+$",
            "split": "\\s*,\\s*|\\s+\u00b7\\s+|:\\s+"
          },
          "axis": "dataIdentifier",
          "status": "covered",
          "requireMin": 20
        }
      ]
    },
    {
      "urlPattern": "waf/latest/developerguide/aws-managed-rule-groups-[a-z-]+\\.md$",
      "serviceId": "wafv2",
      "note": "Rule group names appear only in inline code, as Name: `AWSManagedRules\u2026`.",
      "recipes": [
        {
          "id": "waf-managed-rule-group-names",
          "blocks": "whole-page",
          "select": {
            "from": "code-spans",
            "extract": "regex",
            "pattern": "^(AWSManagedRules[A-Za-z0-9]+)$"
          },
          "axis": "managedRuleGroup",
          "status": "covered",
          "requireMin": 1
        }
      ]
    },
    {
      "urlPattern": "inspector/latest/user/supported\\.md$",
      "serviceId": "inspector2",
      "note": "Operating systems by scan method, plus the languages and runtimes Inspector reads. Each axis gets its own recipe.",
      "recipes": [
        {
          "id": "inspector-os-agentless",
          "blocks": "whole-page",
          "select": {
            "from": "table-column",
            "headerMatches": "operating system",
            "joinColumns": [
              "^version$"
            ],
            "extract": "whole"
          },
          "axis": "operatingSystem",
          "status": "from-column",
          "statusColumn": "agentless scan support",
          "scope": {
            "axis": "scanMethod",
            "from": "constant",
            "value": "agentless"
          },
          "requireMin": 10
        },
        {
          "id": "inspector-os-agent-based",
          "blocks": "whole-page",
          "select": {
            "from": "table-column",
            "headerMatches": "operating system",
            "joinColumns": [
              "^version$"
            ],
            "extract": "whole"
          },
          "axis": "operatingSystem",
          "status": "from-column",
          "statusColumn": "agent-based scan support",
          "scope": {
            "axis": "scanMethod",
            "from": "constant",
            "value": "agent-based"
          },
          "requireMin": 10
        }
      ]
    },
    {
      "urlPattern": "macie/latest/user/discovery-supported-storage\\.md$",
      "serviceId": "macie2",
      "note": "The S3 storage classes Macie reads, and the file formats it can open. Extensions are comma separated inside one cell.",
      "recipes": [
        {
          "id": "macie-storage-classes",
          "blocks": "h2-sections",
          "select": {
            "from": "list-items",
            "extract": "whole",
            "matches": "^(S3|Reduced)"
          },
          "axis": "storageClass",
          "status": "covered",
          "requireMin": 4
        },
        {
          "id": "macie-file-extensions",
          "blocks": "whole-page",
          "select": {
            "from": "table-column",
            "headerMatches": "file name extension",
            "extract": "whole",
            "split": "\\s*,\\s*",
            "matches": "^\\.[a-z0-9]{1,8}$"
          },
          "axis": "fileExtension",
          "status": "covered",
          "requireMin": 8
        }
      ]
    },
    {
      "urlPattern": "guardduty/latest/ug/supported-s3-features-malware-protection-s3\\.md$",
      "serviceId": "guardduty",
      "note": "Which S3 features Malware Protection for S3 can and cannot handle. Several features share one cell, joined by a line break.",
      "recipes": [
        {
          "id": "guardduty-s3-feature-support",
          "blocks": "whole-page",
          "select": {
            "from": "table-column",
            "headerMatches": "s3 feature name",
            "extract": "whole",
            "split": "\\s+\u00b7\\s+"
          },
          "axis": "s3Feature",
          "status": "from-column",
          "statusColumn": "support available",
          "requireMin": 10
        }
      ]
    },
    {
      "urlPattern": "inspector/latest/user/sbom-generator-ecosystem-collection\\.md$",
      "serviceId": "inspector2",
      "note": "Third-party application ecosystems the SBOM generator can inventory.",
      "recipes": [
        {
          "id": "inspector-sbom-ecosystems",
          "blocks": "whole-page",
          "select": {
            "from": "headings",
            "level": 2,
            "extract": "regex",
            "pattern": "^(.*?)(?:\\s+ecosystem collection)?$"
          },
          "axis": "packageEcosystem",
          "status": "covered",
          "requireMin": 10
        }
      ]
    },
    {
      "urlPattern": "securityhub/latest/userguide/standards-reference\\.md$",
      "serviceId": "securityhub",
      "note": "Each standard is a bold-led bullet: the name sits before the dash.",
      "recipes": [
        {
          "id": "securityhub-standards",
          "blocks": "whole-page",
          "select": {
            "from": "list-items",
            "extract": "regex",
            "pattern": "^([A-Z][^\u2013\u2014]{3,70}?)\\s+[\u2013\u2014]"
          },
          "axis": "complianceStandard",
          "status": "covered",
          "requireMin": 4
        }
      ]
    },
    {
      "urlPattern": "audit-manager/latest/userguide/framework-overviews\\.md$",
      "serviceId": "auditmanager",
      "note": "The prebuilt audit frameworks Audit Manager ships.",
      "recipes": [
        {
          "id": "auditmanager-frameworks",
          "blocks": "whole-page",
          "select": {
            "from": "list-items",
            "extract": "whole"
          },
          "axis": "auditFramework",
          "status": "covered",
          "requireMin": 10
        }
      ]
    },
    {
      "urlPattern": "security-lake/latest/userguide/internal-sources\\.md$",
      "serviceId": "securitylake",
      "note": "The AWS log sources Security Lake can ingest natively.",
      "recipes": [
        {
          "id": "securitylake-native-sources",
          "blocks": "whole-page",
          "select": {
            "from": "list-items",
            "extract": "whole",
            "matches": "^(AWS|Amazon)"
          },
          "axis": "logSource",
          "status": "covered",
          "requireMin": 4
        }
      ]
    },
    {
      "urlPattern": "network-firewall/latest/developerguide/aws-managed-rule-groups-threat-signature\\.md$",
      "serviceId": "network-firewall",
      "note": "The Category column of the threat signature rule group table.",
      "recipes": [
        {
          "id": "network-firewall-threat-categories",
          "blocks": "whole-page",
          "select": {
            "from": "table-column",
            "headerMatches": "^category$",
            "extract": "whole"
          },
          "axis": "threatCategory",
          "status": "covered",
          "requireMin": 5
        }
      ]
    },
    {
      "urlPattern": "organizations/latest/userguide/orgs_integrate_services_list\\.md$",
      "serviceId": "organizations",
      "note": "Which AWS services support trusted access with Organizations. Yes and No arrive as icons, which the parser turns back into words.",
      "recipes": [
        {
          "id": "organizations-trusted-access",
          "blocks": "whole-page",
          "select": {
            "from": "table-column",
            "headerMatches": "service",
            "extract": "whole",
            "split": "\\s+\u00b7\\s+",
            "matches": "^(AWS|Amazon)[A-Za-z0-9 ()\\-]{2,50}$"
          },
          "axis": "service",
          "status": "from-column",
          "statusColumn": "trusted access",
          "requireMin": 20
        }
      ]
    },
    {
      "urlPattern": "secretsmanager/latest/userguide/integrating\\.md$",
      "serviceId": "secretsmanager",
      "note": "The AWS services that use Secrets Manager secrets.",
      "recipes": [
        {
          "id": "secretsmanager-integrations",
          "blocks": "whole-page",
          "select": {
            "from": "list-items",
            "extract": "whole",
            "matches": "^(AWS|Amazon)",
            "split": "\\s+\u00b7\\s+"
          },
          "axis": "service",
          "status": "covered",
          "requireMin": 10
        }
      ]
    }
  ]
}
