{
  "_comment": "How to read a page whose shape the generic reader cannot handle. Each rule applies to every page whose URL matches urlPattern. See docs/specs/coverage-extraction.md for the fields. A recipe that stops producing what it promises is reported, never silently dropped.",
  "rules": [
    {
      "urlPattern": "IAM/latest/UserGuide/access-analyzer-resources\\.md$",
      "serviceId": "access-analyzer",
      "note": "One page, three analyzer types, three different resource lists. Each H2 names the analyzer type, so each is pinned to its own feature.",
      "recipes": [
        {
          "id": "access-analyzer-external-resources",
          "blocks": "h2-sections",
          "select": {
            "from": "list-items",
            "extract": "whole",
            "matches": "^(Amazon|AWS) ",
            "split": "\\s+and\\s+(?=layers$)"
          },
          "axis": "resourceType",
          "status": "covered",
          "featureId": "access-analyzer/external-access-analyzer",
          "requireMin": 14,
          "onlyBlocksMatching": "external access"
        },
        {
          "id": "access-analyzer-internal-resources",
          "blocks": "h2-sections",
          "select": {
            "from": "list-items",
            "extract": "whole",
            "matches": "^(Amazon|AWS) ",
            "split": "\\s+and\\s+(?=layers$)"
          },
          "axis": "resourceType",
          "status": "covered",
          "featureId": "access-analyzer/internal-access-analyzer",
          "requireMin": 6,
          "onlyBlocksMatching": "internal access"
        }
      ]
    },
    {
      "urlPattern": "securityhub/latest/userguide/regions-controls\\.md$",
      "serviceId": "securityhub",
      "note": "One H2 per Region, each listing the controls that are NOT available there. The control id is the bracketed prefix of each bullet.",
      "recipes": [
        {
          "id": "securityhub-regional-control-limits",
          "blocks": "h2-sections",
          "select": {
            "from": "list-items",
            "extract": "leading-bracket",
            "matches": "^[A-Z][A-Za-z0-9]{1,20}\\.\\d{1,3}$"
          },
          "axis": "control",
          "status": "not-covered",
          "scope": {
            "axis": "region",
            "from": "block-title"
          },
          "featureId": "securityhub/aws-security-hub-cspm",
          "requireMin": 5000
        }
      ]
    },
    {
      "urlPattern": "config/latest/developerguide/managed-rules-by-aws-config\\.md$",
      "serviceId": "config",
      "note": "The full catalogue of AWS Config managed rules, one bullet each.",
      "recipes": [
        {
          "id": "config-managed-rule-catalogue",
          "blocks": "whole-page",
          "select": {
            "from": "list-items",
            "extract": "whole",
            "matches": "^[a-z][a-z0-9]*(-[a-z0-9]+){1,}$"
          },
          "axis": "configRule",
          "status": "covered",
          "requireMin": 700,
          "featureId": "config/aws-config-rules"
        }
      ]
    },
    {
      "urlPattern": "guardduty/latest/ug/guardduty_finding-types-(?!retired)[a-z0-9-]+\\.md$",
      "serviceId": "guardduty",
      "note": "Each H2 is one active GuardDuty finding type. The retired page is read by its own rule, because it states the opposite.",
      "recipes": [
        {
          "id": "guardduty-finding-type-headings",
          "blocks": "whole-page",
          "select": {
            "from": "headings",
            "level": 2,
            "extract": "whole",
            "matches": "^[A-Z][A-Za-z]*:[A-Za-z0-9]+/[A-Za-z0-9._!&-]+$"
          },
          "axis": "findingType",
          "status": "covered",
          "requireMin": 15,
          "featureId": "guardduty/all-protection-plans"
        }
      ]
    },
    {
      "urlPattern": "macie/latest/user/mdis-reference-quick\\.md$",
      "serviceId": "macie2",
      "note": "The managed data identifier catalogue, in the identifier ID column.",
      "recipes": [
        {
          "id": "macie-managed-data-identifiers",
          "blocks": "whole-page",
          "select": {
            "from": "table-column",
            "headerMatches": "identifier",
            "extract": "regex",
            "matches": "^[A-Z][A-Z0-9_]{2,}$",
            "split": "\\s*\u00b7\\s*|\\s*,\\s*|:\\s+",
            "pattern": "^([A-Z][A-Z0-9_]*)"
          },
          "axis": "dataIdentifier",
          "status": "covered",
          "requireMin": 140,
          "featureId": "macie2/managed-data-identifiers"
        }
      ]
    },
    {
      "urlPattern": "waf/latest/developerguide/aws-managed-rule-groups-(?!changelog|list)[a-z-]+\\.md$",
      "serviceId": "wafv2",
      "note": "Rule group names appear only in inline code, as Name: `AWSManagedRules\u2026`. The changelog and index pages are excluded: neither states capability.",
      "recipes": [
        {
          "id": "waf-managed-rule-group-names",
          "blocks": "whole-page",
          "select": {
            "from": "code-spans",
            "extract": "regex",
            "pattern": "^(AWSManagedRules[A-Za-z0-9]+)$"
          },
          "axis": "managedRuleGroup",
          "status": "covered",
          "requireMin": 1,
          "featureId": "wafv2/aws-managed-rules-rule-groups-list"
        }
      ]
    },
    {
      "urlPattern": "inspector/latest/user/supported\\.md$",
      "serviceId": "inspector2",
      "note": "Operating systems by scan method, plus the languages and runtimes Inspector reads. Each axis gets its own recipe.",
      "recipes": [
        {
          "id": "inspector-os-agentless",
          "blocks": "h3-sections",
          "select": {
            "from": "table-column",
            "headerMatches": "operating system",
            "joinColumns": [
              "^version$"
            ],
            "extract": "whole"
          },
          "axis": "operatingSystem",
          "status": "from-column",
          "statusColumn": "agentless scan support",
          "scope": {
            "axis": "scanMethod",
            "from": "constant",
            "value": "agentless"
          },
          "requireMin": 30,
          "onlyBlocksMatching": "Amazon EC2 scanning",
          "featureId": "inspector2/automated-scans"
        },
        {
          "id": "inspector-os-agent-based",
          "blocks": "h3-sections",
          "select": {
            "from": "table-column",
            "headerMatches": "operating system",
            "joinColumns": [
              "^version$"
            ],
            "extract": "whole"
          },
          "axis": "operatingSystem",
          "status": "from-column",
          "statusColumn": "agent-based scan support",
          "scope": {
            "axis": "scanMethod",
            "from": "constant",
            "value": "agent-based"
          },
          "requireMin": 30,
          "onlyBlocksMatching": "Amazon EC2 scanning",
          "featureId": "inspector2/automated-scans"
        },
        {
          "id": "inspector-languages",
          "blocks": "h3-sections",
          "onlyBlocksMatching": "programming languages",
          "select": {
            "from": "list-items",
            "extract": "whole",
            "matches": "^[A-Za-z][A-Za-z0-9+#. ]{1,30}$"
          },
          "axis": "programmingLanguage",
          "status": "covered",
          "requireMin": 5,
          "featureId": "inspector2/automated-scans"
        },
        {
          "id": "inspector-discontinued-os",
          "blocks": "h2-sections",
          "onlyBlocksMatching": "Discontinued operating systems",
          "select": {
            "from": "table-column",
            "headerMatches": "operating system",
            "joinColumns": [
              "^version$"
            ],
            "extract": "whole"
          },
          "axis": "operatingSystem",
          "status": "not-covered",
          "requireMin": 8,
          "featureId": "inspector2/automated-scans"
        },
        {
          "id": "inspector-ecr-os",
          "blocks": "h3-sections",
          "onlyBlocksMatching": "Amazon ECR scanning",
          "select": {
            "from": "table-column",
            "headerMatches": "operating system",
            "joinColumns": [
              "^version$"
            ],
            "extract": "whole"
          },
          "axis": "operatingSystem",
          "status": "covered",
          "scope": {
            "axis": "scanMethod",
            "from": "constant",
            "value": "ecr-scanning"
          },
          "requireMin": 8,
          "featureId": "inspector2/automated-scans"
        }
      ]
    },
    {
      "urlPattern": "macie/latest/user/discovery-supported-storage\\.md$",
      "serviceId": "macie2",
      "note": "The S3 storage classes Macie reads, and the file formats it can open. Extensions are comma separated inside one cell.",
      "recipes": [
        {
          "id": "macie-storage-classes",
          "blocks": "h2-sections",
          "select": {
            "from": "list-items",
            "extract": "whole",
            "matches": "^(S3|Reduced)"
          },
          "axis": "storageClass",
          "status": "covered",
          "requireMin": 6,
          "featureId": "macie2/running-sensitive-data-discovery-jobs"
        },
        {
          "id": "macie-file-extensions",
          "blocks": "whole-page",
          "select": {
            "from": "table-column",
            "headerMatches": "file name extension",
            "extract": "whole",
            "split": "\\s*,\\s*|:\\s+",
            "matches": "^\\.[a-z0-9]{1,8}$"
          },
          "axis": "fileExtension",
          "status": "covered",
          "requireMin": 20,
          "featureId": "macie2/running-sensitive-data-discovery-jobs"
        },
        {
          "id": "macie-unsupported-storage-classes",
          "blocks": "whole-page",
          "select": {
            "from": "paragraph",
            "sentenceMatches": "does ?n'?t analyze",
            "extract": "regex",
            "pattern": "(S3 Glacier Deep Archive|S3 Express One Zone|S3 directory buckets)",
            "split": "\\s+or\\s+|,\\s+"
          },
          "axis": "storageClass",
          "status": "not-covered",
          "requireMin": 1,
          "featureId": "macie2/running-sensitive-data-discovery-jobs"
        }
      ]
    },
